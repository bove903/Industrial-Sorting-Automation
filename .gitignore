# ==========================================
# TIA Portal (Siemens) - File Temporanei e Log
# ==========================================
Logs/
Tmp/
Compile/
# Cartella fondamentale: contiene i file intermedi di compilazione hardware/software
# Cambia continuamente e genera falsi conflitti su Git
*.log
*.tmp
*~

# ==========================================
# TIA Portal - File di Backup e Diagnostica Utente
# ==========================================
Backup/
*.bak*
# File di diagnostica e log utente specifici della macchina
*.ap1*_ulog
*.ap1*_diag
*.PEData*

# ==========================================
# Factory I/O
# ==========================================
# Factory IO salva tutto nel singolo file .factoryio, ma se usi i driver SDK 
# o generi log di simulazione, questi vanno ignorati
*.fio_log
*.fio_bak

# ==========================================
# File di Sistema e IDE (OS / Windows / Parallels)
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# Se usate editor esterni come VS Code per documentazione o script
.vscode/
*.code-workspace

# ==========================================
# TIA Portal - Protezione File di Sistema e Cache Temporanea
# ==========================================
# Escludi SOLO i file di lock temporanei (quelli che iniziano con ~)
# Questo lascia intatti PEData.plf e PEData.idx per il tuo collega
**/System/~*
**/System/PEData/write.lock

# Escludi SOLO i file dell'indice di ricerca interna (SearchIndex)
# che generano continuamente file .del, .cfs e segmenti temporanei
**/SearchIndex/*.del
**/SearchIndex/*.cfs
**/SearchIndex/segments_*
**/SearchIndex/write.lock

# Escludi le cartelle di backup automatico locali
*.backup/
